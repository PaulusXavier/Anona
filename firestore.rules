rules_version = '2';

// Cole este conteúdo em: Firebase Console > Firestore Database > Regras
// e TESTE no "Playground de regras" antes de publicar (ver SEGURANCA.md).
//
// O que o app grava: só users/{uid} com { notes: { "AAAA-MM-DD": { text, emphasis } } } (anotações do calendário).
// Planilhas de Repercussão ficam apenas no navegador — por isso não há regra para elas (negado por padrão).
service cloud.firestore {
  match /databases/{database}/documents {

    // Documento do próprio usuário: só ele lê/escreve, só o campo "notes", e com limite de tamanho.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['notes'])
                            && request.resource.data.notes is map
                            && request.resource.data.notes.size() <= 3000;

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Todo o resto (inclusive subcoleções de users/{uid}) fica NEGADO.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
