rules_version = '2';

// Cole este conteúdo em: Firebase Console > Firestore Database > Regras
// Ele garante que cada pessoa só consegue ler/escrever as PRÓPRIAS notas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Reservada para uma futura sincronização das planilhas de Repercussão.
      // Hoje o app NÃO usa esta subcoleção — as planilhas ficam só no
      // localStorage do navegador de cada pessoa (veja index.html/README).
      // Mantida aqui, já com a regra correta de dono único, para o dia em
      // que essa sincronização for implementada de verdade.
      match /repercussao/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
