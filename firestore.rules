rules_version = '2';

// Cole este conteúdo em: Firebase Console > Firestore Database > Regras
// e TESTE no "Playground de regras" antes de publicar (ver SEGURANCA.md).
//
// O que o app grava:
//  1) users/{uid} com { notes: { "AAAA-MM-DD": { text, emphasis } } } (anotações do calendário);
//  2) users/{uid}/rotas/{id} — ROTAS SALVAS do "Mapa e rotas": nome, meio de transporte, partida, paradas (até 8), destino e horários.
// Planilhas de Repercussão ficam apenas no navegador — por isso não há regra para elas (negado por padrão).
service cloud.firestore {
  match /databases/{database}/documents {

    // Documento do próprio usuário: só ele lê/escreve, só o campo "notes", e com limite de tamanho.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['notes'])
                            && request.resource.data.notes is map
                            && request.resource.data.notes.size() <= 3000;

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Rotas salvas do próprio usuário: só ele lê/escreve/apaga; só os campos conhecidos, com limites de tamanho.
    match /users/{userId}/rotas/{rotaId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && rotaId.size() <= 40
                            && request.resource.data.keys().hasOnly(['nome', 'modo', 'origem', 'paradas', 'destino', 'saida', 'limite', 'visita', 'criadoEm', 'atualizadoEm'])
                            && request.resource.data.keys().hasAll(['nome', 'modo', 'paradas', 'destino', 'atualizadoEm'])
                            && request.resource.data.nome is string
                            && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
                            && request.resource.data.modo in ['carro', 'pe', 'bike']
                            && request.resource.data.paradas is list
                            && request.resource.data.paradas.size() <= 8
                            && request.resource.data.destino is map
                            && request.resource.data.atualizadoEm is number;
    }

    // Todo o resto (inclusive as demais subcoleções de users/{uid}) fica NEGADO.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
